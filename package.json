{
  "name": "baidu-drive-sdk-js",
  "version": "0.1.0",
  "description": "百度网盘开放平台 SDK：TypeScript 编写、产物为 ESM JavaScript + 完整类型声明、浏览器运行（不依赖 Node）。对齐百度网盘开放平台最新 API。",
  "keywords": [
    "baidu",
    "baidu-netdisk",
    "baidu-drive",
    "netdisk",
    "pan",
    "sdk",
    "typescript",
    "javascript",
    "browser",
    "esm",
    "oauth",
    "cloud-storage"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/baidu-netdisk/baidu-drive-sdk-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baidu-netdisk/baidu-drive-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/baidu-netdisk/baidu-drive-sdk-js/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "VERSION",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./api/auth": {
      "types": "./dist/api/auth/index.d.ts",
      "import": "./dist/api/auth/index.js"
    },
    "./api/auth/vite": {
      "types": "./dist/api/auth/vite.d.mts",
      "default": "./dist/api/auth/vite.mjs"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "import": "./dist/scene/index.js"
    },
    "./scene/file-browse": {
      "types": "./dist/scene/file-browse/index.d.ts",
      "import": "./dist/scene/file-browse/index.js"
    },
    "./scene/file-manage": {
      "types": "./dist/scene/file-manage/index.d.ts",
      "import": "./dist/scene/file-manage/index.js"
    },
    "./scene/file-upload": {
      "types": "./dist/scene/file-upload/index.d.ts",
      "import": "./dist/scene/file-upload/index.js"
    },
    "./scene/file-download": {
      "types": "./dist/scene/file-download/index.d.ts",
      "import": "./dist/scene/file-download/index.js"
    },
    "./scene/user-info": {
      "types": "./dist/scene/user-info/index.d.ts",
      "import": "./dist/scene/user-info/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-static.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:check": "node scripts/check-version.mjs",
    "prepare": "tsup && node scripts/copy-static.mjs",
    "prepublishOnly": "pnpm run version:check && pnpm run type-check && pnpm run test && pnpm run build",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"*.ts\" \"*.json\""
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/spark-md5": "^3.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "~5.7.2",
    "vitest": "^4.0.0"
  }
}
